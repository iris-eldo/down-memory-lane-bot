# Copy to .env and fill in real values. Never commit .env itself.

# From api.slack.com/apps -> your app -> OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# From api.slack.com/apps -> your app -> Basic Information -> App Credentials
SLACK_SIGNING_SECRET=your-signing-secret-here

# From replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your-replicate-token-here

# The trained model, in "owner/model-name:version-id" format.
# Find this on your training's detail page on Replicate once it completes --
# it's shown as the "version" you can run. Looks like:
# your-username/irisface-lora:abc123def456...
REPLICATE_MODEL=your-username/irisface-lora:VERSION_ID_HERE

# Must match exactly what you set as trigger_word during training.
TRIGGER_WORD=IRISFACE
